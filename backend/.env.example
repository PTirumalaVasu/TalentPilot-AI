DATABASE_URL=postgresql+asyncpg://talentpilot:talentpilot@localhost:5432/talentpilot
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION_HOURS=24
# Encrypts admin_api_keys/org_api_credentials at rest (Fernet, AD-10). Required
# -- the app fails fast at startup if unset. Deliberately a separate secret
# from JWT_SECRET (a leaked session-signing secret must not also decrypt
# stored API credentials). Any string works; it's hashed into a valid Fernet
# key internally (core/secrets.py) -- it does not need to be a real Fernet key.
ADMIN_KEY_ENCRYPTION_SECRET=change-me-to-a-different-long-random-string
# Comma-separated list of allowed CORS origins. Local dev + the built SPA's
# served origin (fill in once the frontend build/serve target is decided).
ALLOWED_ORIGINS=http://localhost:5173
SESSION_COOKIE_NAME=access_token
# Secure flag on the session cookie. Defaults True to match production intent,
# but the local dev loop (uvicorn + Vite) runs over plain HTTP with no TLS --
# a real browser will silently refuse to send a Secure cookie back over HTTP.
# Set to False in your local .env for real browser testing.
COOKIE_SECURE=True
# YouTube Data API v3 key, only needed to run the content ingestion CLI
# (`python -m app.content.cli ingest`). Not required for the app to boot or
# serve requests. Leave unset for manual-only content seeding.
YOUTUBE_API_KEY=
# Udemy for Business portal addressing (Story 6.6) -- only needed for the live
# Udemy content-lookup search. The client_id/client_secret credential itself
# lives in org_api_credentials (Story 6.5, configured via the API Keys modal),
# not here. Leave unset if Udemy search isn't needed.
UDEMY_ORGANIZATION_SUBDOMAIN=
UDEMY_ACCOUNT_ID=
